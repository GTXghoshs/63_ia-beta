# Endpoint loopback do servidor llama.cpp
LLAMA_BASE_URL=http://127.0.0.1:8080
# Opcional: use a mesma chave definida com --api-key no llama-server
LLAMA_API_KEY=
# Diretório dos modelos GGUF
MODEL_DIR=~/Models
# Diretório inicial e limite de caminhos do terminal controlado
WORK_DIR=/home/seu-usuario/63_ia-beta
# Binding local por padrão. Para acesso no Wi-Fi, use 0.0.0.0 somente com token.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090
# Acesso remoto desativado por padrão; exige token forte quando ativado.
REMOTE_ACCESS_ENABLED=false
REMOTE_ACCESS_TOKEN=
# O padrão é desabilitado; habilite somente após revisar a allowlist
TERMINAL_ENABLED=false
TERMINAL_TIMEOUT=20
# PATH do sistema usado pelo executor; não inclui .venv por padrão
TERMINAL_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAX_OUTPUT_BYTES=65536
# Nome opcional publicado pelo llama-server
LLAMA_MODEL_ID=
# O projeto público aceita somente o runtime llama.cpp/llama-server e modelos GGUF locais.
LLAMA_CPP_ONLY=true
# Backend de inferência Linux: cpu, vulkan ou auto. Não são aceitos runtimes alternativos.
LLAMA_BACKEND=vulkan
# Identificadores Vulkan separados por vírgula; vazio usa detecção automática.
LLAMA_GPU_IDS=
# GPU principal e divisão opcional de tensores para múltiplas GPUs.
LLAMA_MAIN_GPU=0
LLAMA_TENSOR_SPLIT=
LLAMA_SPLIT_MODE=layer
# Usadas por scripts/start-llama-vulkan.sh
LLAMA_MODEL_PATH=
LLAMA_MODEL_ALIAS=63-ia-local
LLAMA_PORT=8080
LLAMA_N_GPU_LAYERS=999
# Caminho do log de auditoria
AUDIT_LOG=data/audit.jsonl
# Contexto inicial conservador; pode ser elevado até 32768 após benchmark
LLAMA_CONTEXT_SIZE=16384
# Área de ingestão local para uploads, sem execução automática
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=524288000
MAX_UPLOAD_FILES=10
# Caminho absoluto do vault do Obsidian; deixe vazio para manter desativado
OBSIDIAN_VAULT_DIR=
# Busca web opcional via Tavily; crie a chave em https://app.tavily.com
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Cache local em segundos para economizar créditos; zero desabilita cache
TAVILY_CACHE_TTL=900
