#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVICE_NAME="llama-dashboard.service"
PORT="8090"
if [[ -f "$PROJECT_DIR/.env" ]]; then
  PORT="$(sed -n 's/^DASHBOARD_PORT=//p' "$PROJECT_DIR/.env" | head -n 1 | tr -d '\"' | tr -d "'")"
fi
URL="${LLAMA_DASHBOARD_URL:-http://127.0.0.1:${PORT}}"

if command -v systemctl >/dev/null 2>&1 && systemctl --user daemon-reload >/dev/null 2>&1; then
  systemctl --user start "$SERVICE_NAME"
  for _ in {1..20}; do
    if curl -fsS "$URL/api/healthz" >/dev/null 2>&1; then
      break
    fi
    sleep 0.25
done
else
  cd "$PROJECT_DIR"
  exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL" >/dev/null 2>&1 &
else
  printf 'Dashboard disponível em %s\n' "$URL"
fi
